# Dhivagar Mart Environment Configuration Example
# Copy to .env and configure for your local environment

# Database Configuration (PostgreSQL 15+)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dhivagarmart
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Application Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8080
SESSION_IDLE_TIMEOUT_SEC=1800

# AI Chatbot Configuration (gemini | mock)
AI_CHATBOT_PROVIDER=mock
AI_API_KEY=CHANGE_ME
